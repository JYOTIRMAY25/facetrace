# FaceTrace environment template.
#
# Copy to `.env` and fill in locally:   cp .env.example .env
# NEVER commit `.env`, API keys, or private keys. `.gitignore` excludes `.env`.
#
# Every variable below is optional: the package imports and `--health` runs with
# all of them blank, and the default search provider needs no credentials. A
# credentialed provider or a live blockchain write needs the variables noted in
# its section (see the `--health` output for what is still missing).

# ---------------------------------------------------------------------------
# HTTP backend foundation
# ---------------------------------------------------------------------------
ENVIRONMENT=
DATA_DIR=
MAX_UPLOAD_SIZE_BYTES=
CORS_ORIGINS=

# Future integrations (optional; not used in backend foundation)
SEARCH_API_KEY=
SERPAPI_API_KEY=
SEARCH_ENGINE_ID=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_EXPLORER_URL=

# ---------------------------------------------------------------------------
# Genuine web/social search (STEP 3)
# ---------------------------------------------------------------------------
# Identifier of the provider adapter to use. Registered adapters:
#
#   wikimedia-commons     Wikimedia Commons Action API. NO CREDENTIALS NEEDED.
#                         Text-driven, so it needs SEARCH_TERMS, plus a
#                         SEARCH_USER_AGENT naming a contact. Default.
#   google-custom-search  Google Programmable Search JSON API (image mode).
#                         Needs SEARCH_API_KEY + SEARCH_ENGINE_ID and
#                         SEARCH_TERMS.
#   serpapi-google-lens   SerpAPI Google Lens reverse IMAGE search.
#                         Needs SERPAPI_API_KEY. The investigation API uploads
#                         its validated image directly to SerpApi.
#
# Default: wikimedia-commons
SEARCH_PROVIDER=
# Provider API key. Secret — keep it out of version control and out of logs.
#   google-custom-search -> Google API key (console.cloud.google.com, enable
#                           "Custom Search API")
#   serpapi-google-lens  -> SerpAPI private key (serpapi.com/manage-api-key)
#   wikimedia-commons    -> not used, leave blank
SEARCH_API_KEY=
SERPAPI_API_KEY=
# Provider-specific engine/index id. For google-custom-search this is the
# Programmable Search engine id (`cx`), from programmablesearchengine.google.com.
SEARCH_ENGINE_ID=
# Maximum candidate results to request per search. Default: 5
SEARCH_MAX_RESULTS=
# Query terms for the text-driven providers, comma-separated. The search stage
# refuses to invent query terms, so a text provider without this (or --terms)
# fails with SEARCH_QUERY_INVALID instead of running a blank search.
SEARCH_TERMS=
# Optional public image URL for legacy URL-based provider calls. The investigation
# API uploads its validated image directly to SerpApi's image endpoint.
SEARCH_IMAGE_URL=
# User-Agent sent on every search request. Wikimedia's robot policy
# (https://w.wiki/4wJS) requires an agent naming the tool AND a contact, and its
# API answers HTTP 403 without one, so wikimedia-commons reports SEARCH_USER_AGENT
# as missing configuration until you set a real contact of your own, e.g.
#   SEARCH_USER_AGENT=FaceTrace/0.1 (HH Goa 2026 Task 3; you@example.org)
# Default: FaceTrace/0.1 (HH Goa 2026 Task 3 prototype)  -- no contact, will 403
SEARCH_USER_AGENT=

# ---------------------------------------------------------------------------
# Face detection / encoding / matching
# ---------------------------------------------------------------------------
# All face processing runs locally. The image is never uploaded anywhere.
#
# Detector label recorded on every detection. Default: insightface-det_10g
FACE_DETECTOR_MODEL=
# Encoder label recorded on every encoding. Default: insightface-w600k_r50
FACE_ENCODER_MODEL=
# InsightFace model pack providing both models. Default: buffalo_l
FACE_MODEL_PACK=
# Square detector input size in pixels. Larger finds smaller faces, slower.
# Default: 640
FACE_DET_SIZE=
# Minimum detector score for a box to count as a face, 0.0-1.0. Default: 0.5
FACE_MIN_DET_SCORE=
# Directory holding a pre-downloaded model pack, for a fully offline run.
# Leave blank to use the default cache (~/.insightface), which downloads the
# pack once on first use. Default: unset
FACE_MODEL_ROOT=
# Minimum similarity to accept a match, 0.0-1.0. Tune experimentally and
# document the final value in README.md. Default: 0.65
FACE_MATCH_THRESHOLD=

# ---------------------------------------------------------------------------
# Fingerprint
# ---------------------------------------------------------------------------
# Canonicalization version recorded with each fingerprint. Default: 1
CANONICALIZATION_VERSION=
# Hash algorithm label. Default: SHA-256
FINGERPRINT_ALGORITHM=

# ---------------------------------------------------------------------------
# Blockchain (STEP 2)
# ---------------------------------------------------------------------------
# Network label recorded on each record, e.g. local, sepolia. Default: local
BLOCKCHAIN_NETWORK=
# JSON-RPC endpoint of the local chain or testnet.
BLOCKCHAIN_RPC_URL=
# Signing key for the submitting account. SECRET. Use a throwaway test key
# with no mainnet funds. Never log it, never commit it.
BLOCKCHAIN_PRIVATE_KEY=
# Set to 11155111 for Sepolia:
BLOCKCHAIN_CHAIN_ID=
# Deployed address; leave blank until deployment:
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_EXPLORER_URL=
# Deployed FingerprintRegistry address.
CONTRACT_ADDRESS=
# Seconds to wait for transaction confirmation. Default: 120
BLOCKCHAIN_TX_TIMEOUT_S=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Working directory for local artefacts. Default: <project>/data
DATA_DIR=
# HTTP timeout in seconds. Default: 30
REQUEST_TIMEOUT_S=
# Retry attempts for transient failures only. Default: 2
MAX_RETRIES=
CANDIDATE_IMAGE_MAX_BYTES=
